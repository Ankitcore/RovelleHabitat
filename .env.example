# Rovelle Habitat Environment Configuration
# Copy this file to .env.local for local development

# Site URL for metadata and canonical URLs
NEXT_PUBLIC_SITE_URL=https://rovellehabitat.com

# Form notification recipient (real configured email for property enquiries)
ENQUIRY_NOTIFICATION_EMAIL=itsankitkumar405@gmail.com

# Optional: SMTP / Resend / SendGrid credentials if direct email dispatch is active
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Storage mode for enquiries: "local" (in-memory & json file record) or "database"
ENQUIRY_STORAGE_MODE=local
